# API Gateway
GATEWAY_PORT=3000

# JWT
JWT_SECRET=replace_with_your_secret

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:9092

# PostgreSQL
AUTH_DATABASE_URL=postgresql://user:password@auth-db:5432/auth_db
CUSTOMER_DATABASE_URL=postgresql://user:password@customer-db:5432/customer_db
ORDER_DATABASE_URL=postgresql://user:password@order-db:5432/order_db

# MongoDB
PRODUCT_MONGO_URI=mongodb://product-db:27017/product_db
SHIPMENT_MONGO_URI=mongodb://shipment-db:27017/shipment_db